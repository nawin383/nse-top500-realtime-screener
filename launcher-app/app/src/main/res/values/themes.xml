<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Plain AOSP theme, not a Material Components one -- this app never
         pulls in the material-components-android library, so nothing here
         can accidentally introduce a colored default scheme. Compose owns
         all real theming; this only fixes the pre-Compose frame (window
         background, action bar, system bar colors) so cold start never
         flashes white. -->
    <style name="Theme.PureLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pure_black</item>
        <item name="android:statusBarColor">@color/pure_black</item>
        <item name="android:navigationBarColor">@color/pure_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
