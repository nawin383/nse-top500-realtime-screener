<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed pre-scoped-storage (API 24-28) to save exports into the
         public Downloads folder via the legacy File API; API 29+ uses
         MediaStore.Downloads instead, which needs no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Required on API 33+ to post any notification at all; requested at
         runtime in MainActivity, this just declares the app may ask. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Nse500"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:theme="@style/Theme.Nse500.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link used by AlertsWorker's notification taps and the
                 home screen widget: nse500://symbol/<SYMBOL> opens straight
                 to the screener with that symbol pre-searched (see
                 MainActivity.handleIntent and App.jsx's
                 window.__nativeSetSearch bridge). A custom scheme, not an
                 https App Link -- the deployed site has no per-symbol URL of
                 its own to verify domain ownership against (single-page,
                 no client router; see App.jsx). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nse500" android:host="symbol" />
            </intent-filter>
        </activity>

        <!-- In-app browser for the external dashboard links: see
             WebViewActivity's own doc comment. -->
        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:theme="@style/Theme.Nse500" />

        <!-- Home screen widget: shows the last-seen market status and most
             recent alerts, kept fresh by AlertsWorker's periodic background
             poll (see its doc comment) rather than its own update schedule,
             so there's exactly one network poller, not two. -->
        <receiver
            android:name=".AlertsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alerts_widget_info" />
        </receiver>
    </application>
</manifest>
