<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Real Material 3 dark scheme: distinct tonal roles from the light
         scheme (not the same colors with backgrounds flipped). -->
    <style name="Theme.Nse500" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_dark_primary</item>
        <item name="colorOnPrimary">@color/md_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_dark_onTertiaryContainer</item>
        <item name="colorError">@color/md_dark_error</item>
        <item name="colorOnError">@color/md_dark_onError</item>
        <item name="colorErrorContainer">@color/md_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_dark_background</item>
        <item name="colorOnBackground">@color/md_dark_onBackground</item>
        <item name="colorSurface">@color/md_dark_surface</item>
        <item name="colorOnSurface">@color/md_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_dark_outline</item>
        <item name="android:statusBarColor">@color/md_dark_surface</item>
        <item name="android:navigationBarColor">@color/md_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="postSplashScreenTheme">@style/Theme.Nse500</item>
    </style>

    <style name="Theme.Nse500.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Nse500</item>
    </style>
</resources>
