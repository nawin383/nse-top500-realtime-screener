# Kite / Kit WebSocket Credentials (backend only - never expose to frontend)
KITE_API_KEY=
KITE_ACCESS_TOKEN=
KITE_CLIENT_ID=
WEBSOCKET_URL=wss://ws.kite.trade/

# App
DATA_MODE=mock
# mock | live | replay
NSE_UNIVERSE_FILE=config/nse_top500.json
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Market engine
STALE_THRESHOLD_SEC=30
CANDLE_INTERVALS=1,3,5,15,30
WS_BROADCAST_INTERVAL_MS=250
MAX_ALERTS=1000
REPLAY_SPEED=10
REPLAY_FILE=

# Scoring weights (must sum awareness - configurable)
SCORE_W_MOMENTUM=25
SCORE_W_VOLUME=25
SCORE_W_REL_VOLUME=20
SCORE_W_BREAKOUT=15
SCORE_W_VWAP=10
SCORE_W_VOLATILITY=5

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
